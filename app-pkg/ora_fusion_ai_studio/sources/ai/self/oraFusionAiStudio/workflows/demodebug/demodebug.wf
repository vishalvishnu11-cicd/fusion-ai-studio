            "10": "1770888050218"
          },
          "code": "SCENERIOSWITCH",
          "convergenceTargetId": "end",
          "id": "1770726607304",
          "inputs": [
            {
              "id": "1770726607305_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$variables.scenario}}"
            }
          ],
          "type": "SWITCH",
          "diagram": {
            "x": 6556,
            "y": 5000
          }
        },
        {
          "metadata": {
            "name": "setDelayedFilter",
            "returnType": "string",
            "sourceCode": "const result = \"Status='Open' AND lines.Status='Open' AND ((lines.schedules.PromisedDeliveryDate > '2026-08-20' AND lines.schedules.PromisedDeliveryDate < '2026-11-18') OR ( lines.schedules.RequestedDeliveryDate > '2026-08-20' AND lines.schedules.RequestedDeliveryDate < '2026-11-18' ))\";\nreturn result;"
          },
          "outcomes": {
            "success": "1770887827664"
          },
          "code": "SETDELAYEDFILTER",
          "id": "1770888050218",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 7006,
            "y": 5000
          }
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_PRC_PURCHASING_PURCHASEORDERSC",
            "functionName": "getall_purchaseOrders",
            "name": "Get Delayed Orders"
          },
          "outcomes": {
            "success": "1770888686183"
          },
          "code": "GETDELAYEDORDERS",
          "id": "1770887827664",
          "inputs": [
            {
              "id": "1770887854255_1",
              "name": "q_parameter",
              "value": "{{$context.$nodes.SETDELAYEDFILTER.$output.result}}",
              "required": true,
              "type": "string"
            },
            {
              "id": "1770887854255_2",
              "name": "pLimit",
              "value": "500",
              "required": true
            },
            {
              "id": "1770887854256_4",
              "name": "pFields",
              "value": "OrderNumber,Supplier,SupplierSite,OrderDate;lines:Item,Status;lines.schedules:RequestedDeliveryDate,PromisedDeliveryDate,Quantity",
              "required": true,
              "type": "string"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION",
          "diagram": {
            "x": 7456,
            "y": 5000
          }
        },
        {
          "metadata": {
            "name": "Suggest Delayed Orders"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "SUGGESTDELAYEDORDERS",
          "id": "1770888686183",
          "inputs": [
            {
              "id": "1770888686184_1",
              "name": "prompt",
              "type": "string",
              "value": "-Review REST API response:  {{$context.$nodes.GETDELAYEDORDERS.$output}} \n- Include lines where lines.Status='Open' AND 'PromisedDeliveryDate > RequestedDeliveryDate'. \n- Exclude lines where 'PromisedDeliveryDate is less than or equal to RequestedDeliveryDate' or 'RequestedDeliveryDate' is less than {{$context.$system.$currentDate}}.\n- If Item number is available in user input - Filter records only for Item {{$context.$variables.itemNumber}} .\n- Calculate 'Delay' in days as difference between PromisedDeliveryDate and RequestedDeliveryDate. \n- Output: Strictly display Order , Supplier (Site), Item, RequestedDeliveryDate, PromisedDeliveryDate, Delay. Sort the output by Delay desc. \n- Display output in HTML table with border."
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 7906,
            "y": 5000
          }
